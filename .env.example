CODEAUDIT_DAILY_LIMIT=10
CODEAUDIT_CONCURRENCY=2
CODEAUDIT_TIMEOUT_SECONDS=300
CODEAUDIT_MAX_REPOSITORY_MB=20
CODEAUDIT_RETENTION_HOURS=24
GOOGLE_CLOUD_PROJECT=jumpeicloud
# ローカル設定用。APIとワーカーを再起動すると反映されます。
GEMINI_API_KEY=
CODEAUDIT_ACCEPTING_AUDITS=true
CODEAUDIT_STORE=sqlite
CODEAUDIT_DISPATCHER=local
CODEAUDIT_FIRESTORE_DATABASE=codeaudit
CODEAUDIT_REGION=asia-northeast1
CODEAUDIT_JOB_NAME=codeaudit-worker
CODEAUDIT_MAX_FILES=2000
CODEAUDIT_MAX_FILE_BYTES=512000
CODEAUDIT_TOOL_TIMEOUT_SECONDS=90
CODEAUDIT_AI_ENABLED=true
CODEAUDIT_GEMINI_MODEL=gemini-3.5-flash-lite
CODEAUDIT_AI_CHUNK_CHARS=24000
CODEAUDIT_AI_MAX_CALLS=12
CODEAUDIT_AI_MAX_TOTAL_TOKENS=60000
CODEAUDIT_AI_MAX_OUTPUT_TOKENS=3000
CODEAUDIT_AI_MAX_COST_USD=1.5
CODEAUDIT_AI_PRICE_CEILING_PER_MILLION=20
CODEAUDIT_DAILY_BUDGET_USD=3
# クラウドでは32文字以上の乱数。Secret Managerから注入します。
CODEAUDIT_IDENTITY_SALT=
# バイナリの実行パスは必要な場合だけ指定します。
CODEAUDIT_GITLEAKS_BIN=gitleaks
CODEAUDIT_SEMGREP_BIN=semgrep
CODEAUDIT_TRIVY_BIN=trivy
